# ── Required ──────────────────────────────────────────────────────────────────
# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Any model available on OpenRouter (default: claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional: UK Companies House (required for GB jurisdiction) ───────────────
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ── Optional: OpenCorporates (increases rate limits) ─────────────────────────
# Register at: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=

# ── Job Settings ──────────────────────────────────────────────────────────────
# How long (hours) to retain completed jobs in memory
JOB_TTL_HOURS=24

# Per-module fetch timeout in seconds
MODULE_TIMEOUT_SECONDS=90
