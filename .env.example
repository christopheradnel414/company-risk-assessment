# ── Required ──────────────────────────────────────────────────────────────────
# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Any model available on OpenRouter (default: deepseek/deepseek-v4-flash)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional: UK Companies House (required for GB jurisdiction) ───────────────
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ── Job Settings ──────────────────────────────────────────────────────────────
# How long (hours) to retain completed jobs in memory
JOB_TTL_HOURS=24

# Per-module fetch timeout in seconds
MODULE_TIMEOUT_SECONDS=90
