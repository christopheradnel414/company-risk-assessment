{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "companies_house",
  "type": "object",
  "definitions": {
    "address": {
      "type": "object",
      "properties": {
        "address_line_1": { "type": "string" },
        "address_line_2": { "type": "string" },
        "care_of":        { "type": "string" },
        "country":        { "type": "string" },
        "locality":       { "type": "string" },
        "po_box":         { "type": "string" },
        "postal_code":    { "type": "string" },
        "premises":       { "type": "string" },
        "region":         { "type": "string" }
      }
    }
  },
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "company_name":                              { "type": "string" },
        "company_number":                            { "type": "string" },
        "company_status":                            { "type": "string" },
        "company_status_detail":                     { "type": "string" },
        "type":                                      { "type": "string" },
        "subtype":                                   { "type": "string" },
        "jurisdiction":                              { "type": "string" },
        "date_of_creation":                          { "type": "string", "format": "date" },
        "date_of_cessation":                         { "type": "string", "format": "date" },
        "has_been_liquidated":                       { "type": "boolean" },
        "has_charges":                               { "type": "boolean" },
        "has_insolvency_history":                    { "type": "boolean" },
        "is_community_interest_company":             { "type": "boolean" },
        "can_file":                                  { "type": "boolean" },
        "registered_office_is_in_dispute":           { "type": "boolean" },
        "undeliverable_registered_office_address":   { "type": "boolean" },
        "partial_data_available":                    { "type": "string" },
        "etag":                                      { "type": "string" },
        "external_registration_number":              { "type": "string" },
        "last_full_members_list_date":               { "type": "string", "format": "date" },
        "sic_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "registered_office_address": { "$ref": "#/definitions/address" },
        "service_address":            { "$ref": "#/definitions/address" },
        "previous_company_names": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name":           { "type": "string" },
              "effective_from": { "type": "string", "format": "date" },
              "ceased_on":      { "type": "string", "format": "date" }
            }
          }
        },
        "accounts": {
          "type": "object",
          "properties": {
            "accounting_reference_date": {
              "type": "object",
              "properties": {
                "day":   { "type": "string" },
                "month": { "type": "string" }
              }
            },
            "last_accounts": {
              "type": "object",
              "properties": {
                "made_up_to":      { "type": "string", "format": "date" },
                "period_end_on":   { "type": "string", "format": "date" },
                "period_start_on": { "type": "string", "format": "date" },
                "type":            { "type": "string" }
              }
            },
            "next_accounts": {
              "type": "object",
              "properties": {
                "due_on":          { "type": "string", "format": "date" },
                "overdue":         { "type": "boolean" },
                "period_end_on":   { "type": "string", "format": "date" },
                "period_start_on": { "type": "string", "format": "date" }
              }
            },
            "next_due":        { "type": "string", "format": "date" },
            "next_made_up_to": { "type": "string", "format": "date" },
            "overdue":         { "type": "boolean" }
          }
        },
        "annual_return": {
          "type": "object",
          "properties": {
            "last_made_up_to": { "type": "string", "format": "date" },
            "next_due":        { "type": "string", "format": "date" },
            "next_made_up_to": { "type": "string", "format": "date" },
            "overdue":         { "type": "boolean" }
          }
        },
        "confirmation_statement": {
          "type": "object",
          "properties": {
            "last_made_up_to": { "type": "string", "format": "date" },
            "next_due":        { "type": "string", "format": "date" },
            "next_made_up_to": { "type": "string", "format": "date" },
            "overdue":         { "type": "boolean" }
          }
        },
        "branch_company_details": {
          "type": "object",
          "properties": {
            "business_activity":    { "type": "string" },
            "parent_company_name":  { "type": "string" },
            "parent_company_number":{ "type": "string" }
          }
        },
        "foreign_company_details": {
          "type": "object",
          "properties": {
            "business_activity":              { "type": "string" },
            "company_type":                   { "type": "string" },
            "governed_by":                    { "type": "string" },
            "is_a_credit_finance_institution": { "type": "boolean" },
            "registration_number":            { "type": "string" },
            "originating_registry": {
              "type": "object",
              "properties": {
                "country": { "type": "string" },
                "name":    { "type": "string" }
              }
            },
            "accounting_requirement": {
              "type": "object",
              "properties": {
                "foreign_account_type":          { "type": "string" },
                "terms_of_account_publication":  { "type": "string" }
              }
            },
            "accounts": {
              "type": "object",
              "properties": {
                "account_period_from": {
                  "type": "object",
                  "properties": {
                    "day":   { "type": "integer" },
                    "month": { "type": "integer" }
                  }
                },
                "account_period_to": {
                  "type": "object",
                  "properties": {
                    "day":   { "type": "integer" },
                    "month": { "type": "integer" }
                  }
                },
                "must_file_within": {
                  "type": "object",
                  "properties": {
                    "months": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "corporate_annotation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "created_on":  { "type": "string", "format": "date" },
              "description": { "type": "string" },
              "type":        { "type": "string" }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "self":                                        { "type": "string" },
            "filing_history":                             { "type": "string" },
            "officers":                                   { "type": "string" },
            "persons_with_significant_control":           { "type": "string" },
            "charges":                                    { "type": "string" },
            "insolvency":                                 { "type": "string" },
            "registers":                                  { "type": "string" },
            "exemptions":                                 { "type": "string" },
            "overseas":                                   { "type": "string" },
            "uk-establishments":                          { "type": "string" },
            "persons_with_significant_control_statements":{ "type": "string" }
          }
        }
      }
    },

    "officers": {
      "type": "object",
      "properties": {
        "active_count":   { "type": "integer" },
        "resigned_count": { "type": "integer" },
        "total_results":  { "type": "integer" },
        "items_per_page": { "type": "integer" },
        "start_index":    { "type": "integer" },
        "kind":           { "type": "string" },
        "etag":           { "type": "string" },
        "links": {
          "type": "object",
          "properties": {
            "self": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name":                  { "type": "string" },
              "officer_role":          { "type": "string" },
              "appointed_on":          { "type": "string", "format": "date" },
              "appointed_before":      { "type": "string" },
              "resigned_on":           { "type": "string", "format": "date" },
              "nationality":           { "type": "string" },
              "occupation":            { "type": "string" },
              "country_of_residence":  { "type": "string" },
              "responsibilities":      { "type": "string" },
              "person_number":         { "type": "string" },
              "etag":                  { "type": "string" },
              "is_pre_1992_appointment": { "type": "boolean" },
              "address":                { "$ref": "#/definitions/address" },
              "principal_office_address": { "$ref": "#/definitions/address" },
              "date_of_birth": {
                "type": "object",
                "properties": {
                  "month": { "type": "integer" },
                  "year":  { "type": "integer" }
                }
              },
              "former_names": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "forenames": { "type": "string" },
                    "surname":   { "type": "string" }
                  }
                }
              },
              "identification": {
                "type": "object",
                "properties": {
                  "identification_type": { "type": "string" },
                  "legal_authority":     { "type": "string" },
                  "legal_form":          { "type": "string" },
                  "place_registered":    { "type": "string" },
                  "registration_number": { "type": "string" }
                }
              },
              "contact_details": {
                "type": "object",
                "properties": {
                  "contact_name": { "type": "string" }
                }
              },
              "links": {
                "type": "object",
                "properties": {
                  "self": { "type": "string" },
                  "officer": {
                    "type": "object",
                    "properties": {
                      "appointments": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "filing_history": {
      "type": "object",
      "properties": {
        "total_count":           { "type": "integer" },
        "items_per_page":        { "type": "integer" },
        "start_index":           { "type": "integer" },
        "filing_history_status": { "type": "string" },
        "etag":                  { "type": "string" },
        "kind":                  { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category":       { "type": "string" },
              "subcategory":    { "type": "string" },
              "date":           { "type": "string", "format": "date" },
              "description":    { "type": "string" },
              "type":           { "type": "string" },
              "barcode":        { "type": "string" },
              "transaction_id": { "type": "string" },
              "pages":          { "type": "integer" },
              "paper_filed":    { "type": "boolean" },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "annotation":  { "type": "string" },
                    "date":        { "type": "string", "format": "date" },
                    "description": { "type": "string" }
                  }
                }
              },
              "associated_filings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date":        { "type": "string", "format": "date" },
                    "description": { "type": "string" },
                    "type":        { "type": "string" }
                  }
                }
              },
              "resolutions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category":     { "type": "string" },
                    "description":  { "type": "string" },
                    "document_id":  { "type": "string" },
                    "receive_date": { "type": "string", "format": "date" },
                    "subcategory":  { "type": "string" },
                    "type":         { "type": "string" }
                  }
                }
              },
              "links": {
                "type": "object",
                "properties": {
                  "self":              { "type": "string" },
                  "document_metadata": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },

    "persons_with_significant_control": {
      "type": "object",
      "properties": {
        "active_count":   { "type": "integer" },
        "ceased_count":   { "type": "integer" },
        "total_results":  { "type": "integer" },
        "items_per_page": { "type": "integer" },
        "start_index":    { "type": "integer" },
        "links": {
          "type": "object",
          "properties": {
            "self":                                      { "type": "string" },
            "persons_with_significant_control_list":    { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind":                 { "type": "string" },
              "name":                 { "type": "string" },
              "nationality":          { "type": "string" },
              "country_of_residence": { "type": "string" },
              "description":          { "type": "string" },
              "etag":                 { "type": "string" },
              "ceased":               { "type": "boolean" },
              "ceased_on":            { "type": "string", "format": "date" },
              "notified_on":          { "type": "string", "format": "date" },
              "is_sanctioned":        { "type": "boolean" },
              "natures_of_control": {
                "type": "array",
                "items": { "type": "string" }
              },
              "address":                  { "$ref": "#/definitions/address" },
              "principal_office_address": { "$ref": "#/definitions/address" },
              "date_of_birth": {
                "type": "object",
                "properties": {
                  "month": { "type": "integer" },
                  "year":  { "type": "integer" }
                }
              },
              "name_elements": {
                "type": "object",
                "properties": {
                  "title":       { "type": "string" },
                  "forename":    { "type": "string" },
                  "middle_name": { "type": "string" },
                  "surname":     { "type": "string" }
                }
              },
              "identification": {
                "type": "object",
                "properties": {
                  "country_registered":  { "type": "string" },
                  "legal_authority":     { "type": "string" },
                  "legal_form":          { "type": "string" },
                  "place_registered":    { "type": "string" },
                  "registration_number": { "type": "string" }
                }
              },
              "links": {
                "type": "object",
                "properties": {
                  "self":      { "type": "string" },
                  "statement": { "type": "string" },
                  "persons_with_significant_control": {
                    "type": "object",
                    "properties": {
                      "notifications": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
