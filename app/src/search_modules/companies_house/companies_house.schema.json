{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "companies_house",
  "type": "object",
  "definitions": {
    "address": {
      "type": "object",
      "properties": {
        "address_line_1": { "type": "string" },
        "address_line_2": { "type": "string" },
        "care_of":        { "type": "string" },
        "country":        { "type": "string" },
        "locality":       { "type": "string" },
        "po_box":         { "type": "string" },
        "postal_code":    { "type": "string" },
        "premises":       { "type": "string" },
        "region":         { "type": "string" }
      }
    }
  },
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "company_name":                    { "type": "string" },
        "company_number":                  { "type": "string" },
        "company_status":                  { "type": "string" },
        "company_status_detail":           { "type": "string" },
        "type":                            { "type": "string" },
        "jurisdiction":                    { "type": "string" },
        "date_of_creation":                { "type": "string", "format": "date" },
        "date_of_cessation":               { "type": "string", "format": "date" },
        "has_been_liquidated":             { "type": "boolean" },
        "has_charges":                     { "type": "boolean" },
        "has_insolvency_history":          { "type": "boolean" },
        "is_community_interest_company":   { "type": "boolean" },
        "registered_office_is_in_dispute":           { "type": "boolean" },
        "undeliverable_registered_office_address":   { "type": "boolean" },
        "sic_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "registered_office_address": { "$ref": "#/definitions/address" },
        "previous_company_names": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name":           { "type": "string" },
              "effective_from": { "type": "string", "format": "date" },
              "ceased_on":      { "type": "string", "format": "date" }
            }
          }
        },
        "accounts": {
          "type": "object",
          "properties": {
            "last_accounts": {
              "type": "object",
              "properties": {
                "made_up_to":    { "type": "string", "format": "date" },
                "period_end_on": { "type": "string", "format": "date" },
                "type":          { "type": "string" }
              }
            },
            "next_accounts": {
              "type": "object",
              "properties": {
                "due_on":  { "type": "string", "format": "date" },
                "overdue": { "type": "boolean" }
              }
            },
            "overdue": { "type": "boolean" }
          }
        },
        "annual_return": {
          "type": "object",
          "properties": {
            "last_made_up_to": { "type": "string", "format": "date" },
            "next_due":        { "type": "string", "format": "date" },
            "overdue":         { "type": "boolean" }
          }
        },
        "confirmation_statement": {
          "type": "object",
          "properties": {
            "last_made_up_to": { "type": "string", "format": "date" },
            "next_due":        { "type": "string", "format": "date" },
            "overdue":         { "type": "boolean" }
          }
        },
        "branch_company_details": {
          "type": "object",
          "properties": {
            "business_activity":     { "type": "string" },
            "parent_company_name":   { "type": "string" },
            "parent_company_number": { "type": "string" }
          }
        },
        "corporate_annotation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "created_on":  { "type": "string", "format": "date" },
              "description": { "type": "string" },
              "type":        { "type": "string" }
            }
          }
        },
        "foreign_company_details": {
          "type": "object",
          "properties": {
            "business_activity":   { "type": "string" },
            "company_type":        { "type": "string" },
            "governed_by":         { "type": "string" },
            "registration_number": { "type": "string" },
            "originating_registry": {
              "type": "object",
              "properties": {
                "country": { "type": "string" },
                "name":    { "type": "string" }
              }
            }
          }
        }
      }
    },

    "officers": {
      "type": "object",
      "properties": {
        "active_count":   { "type": "integer" },
        "resigned_count": { "type": "integer" },
        "total_results":  { "type": "integer" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name":                 { "type": "string" },
              "officer_role":         { "type": "string" },
              "appointed_on":         { "type": "string", "format": "date" },
              "resigned_on":          { "type": "string", "format": "date" },
              "nationality":          { "type": "string" },
              "occupation":           { "type": "string" },
              "country_of_residence": { "type": "string" },
              "address":              { "$ref": "#/definitions/address" },
              "date_of_birth": {
                "type": "object",
                "properties": {
                  "month": { "type": "integer" },
                  "year":  { "type": "integer" }
                }
              },
              "former_names": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "forenames": { "type": "string" },
                    "surname":   { "type": "string" }
                  }
                }
              },
              "identification": {
                "type": "object",
                "properties": {
                  "identification_type": { "type": "string" },
                  "legal_authority":     { "type": "string" },
                  "legal_form":          { "type": "string" },
                  "place_registered":    { "type": "string" },
                  "registration_number": { "type": "string" }
                }
              },
              "appointments": {
                "type": "object",
                "properties": {
                  "total_results": { "type": "integer" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "officer_role":         { "type": "string" },
                        "appointed_on":         { "type": "string", "format": "date" },
                        "resigned_on":          { "type": "string", "format": "date" },
                        "country_of_residence": { "type": "string" },
                        "nationality":          { "type": "string" },
                        "occupation":           { "type": "string" },
                        "appointed_to": {
                          "type": "object",
                          "properties": {
                            "company_name":   { "type": "string" },
                            "company_number": { "type": "string" },
                            "company_status": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "filing_history": {
      "type": "object",
      "properties": {
        "total_count": { "type": "integer" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category":    { "type": "string" },
              "subcategory": { "type": "string" },
              "date":        { "type": "string", "format": "date" },
              "description": { "type": "string" },
              "type":        { "type": "string" },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "annotation":  { "type": "string" },
                    "date":        { "type": "string", "format": "date" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "persons_with_significant_control": {
      "type": "object",
      "properties": {
        "active_count":  { "type": "integer" },
        "ceased_count":  { "type": "integer" },
        "total_results": { "type": "integer" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind":                 { "type": "string" },
              "name":                 { "type": "string" },
              "nationality":          { "type": "string" },
              "country_of_residence": { "type": "string" },
              "ceased":               { "type": "boolean" },
              "ceased_on":            { "type": "string", "format": "date" },
              "notified_on":          { "type": "string", "format": "date" },
              "is_sanctioned":        { "type": "boolean" },
              "natures_of_control": {
                "type": "array",
                "items": { "type": "string" }
              },
              "address":       { "$ref": "#/definitions/address" },
              "date_of_birth": {
                "type": "object",
                "properties": {
                  "month": { "type": "integer" },
                  "year":  { "type": "integer" }
                }
              },
              "name_elements": {
                "type": "object",
                "properties": {
                  "title":       { "type": "string" },
                  "forename":    { "type": "string" },
                  "middle_name": { "type": "string" },
                  "surname":     { "type": "string" }
                }
              },
              "identification": {
                "type": "object",
                "properties": {
                  "country_registered":  { "type": "string" },
                  "legal_authority":     { "type": "string" },
                  "legal_form":          { "type": "string" },
                  "place_registered":    { "type": "string" },
                  "registration_number": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
